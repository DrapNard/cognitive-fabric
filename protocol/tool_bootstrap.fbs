// Host-authenticated built-in worker grant; no executable paths.
// Version 1 is arithmetic-only; version 2 is SQL-only with identical fields.
namespace ToolSetup;
table Bootstrap {
 version:ushort = 1;
 task_id:string (required);
 module_id:string (required);
 module_version:string (required);
 capability:string (required);
 calls:uint;
 seconds:ulong;
 max_database_bytes:ulong;
}
root_type Bootstrap;
file_identifier "COTB";
