// Versioned, typed Cognitive Fabric IPC schema.
// Only one of request, response or error is populated per envelope.
namespace Cognitive;

enum MessageKind:ubyte { Request = 0, Response = 1, Error = 2, Control = 3, ControlResponse = 4 }
enum ControlAction:ubyte { Status = 0, CancelActive = 1, Stop = 2, Modules = 3, TaskProgress = 4, CancelTask = 5, SubscribeProgress = 6, ToolModules = 7, InferenceModules = 8 }
enum ToolAvailability:ubyte { Unknown = 0, Connected = 1, InUse = 2, Closed = 3, Expired = 4, Exhausted = 5 }
enum ReasoningMode:ubyte { Fast = 0, Standard = 1, Deep = 2, Research = 3 }

table AskRequest {
  query:string (required);
  mode:ReasoningMode = Standard;
  conversation_ref:string;
  explain:bool;
}

table ResourceUsage {
  reserved_output_tokens:ulong;
  prompt_bytes:ulong;
  input_tokens:ulong = null;
  output_tokens:ulong = null;
  inference_ms:double;
  tool_calls:uint;
  queue_wait_ms:double = null;
  process_rss_bytes:ulong = null;
  process_lifetime_peak_rss_bytes:ulong = null;
}

table AskResponse {
  task_id:string (required);
  answer:string (required);
  status:string (required);
  model_calls:uint;
  cycles:uint;
  elapsed_ms:double;
  evidence:[string];
  skills:[string];
  resources:ResourceUsage;
  stop_reason:string;
}

table ProtocolError {
  message:string (required);
}

table ControlRequest {
  action:ControlAction;
  task_id:string;
  after_sequence:ulong;
}

table ControlResponse {
  active:bool;
  accepted:bool;
  modules:[ModuleInfo];
  active_task_id:string;
  progress:ProgressPage;
  stream_state:string;
  tool_modules:[ToolModuleInfo];
  inference_modules:[InferenceModuleInfo];
}

table ToolModuleInfo {
  id:string (required);
  version:string (required);
  capability:string (required);
  active:bool;
  availability:ToolAvailability;
  routing_rank:uint = null;
}

table ProgressFrame { data:[ubyte] (required); }
table ProgressPage { task_id:string (required); cursor:ulong; more:bool; events:[ProgressFrame]; }

table ModuleInfo {
  id:string (required);
  version:string (required);
  roles:[string];
}

table Envelope {
  version:ushort = 1;
  request_id:string (required);
  kind:MessageKind;
  request:AskRequest;
  response:AskResponse;
  error:ProtocolError;
  control:ControlRequest;
  control_response:ControlResponse;
}

root_type Envelope;
file_identifier "COGF";

table InferenceModuleInfo {
  descriptor:ModuleInfo (required);
  active:bool;
  availability:ToolAvailability;
  routing_rank:uint = null;
}
