{
  "$schema": "https://opencode.ai/config.json",
  "model": "cogfabric/cogfabric-agent",
  "providers": {
    "cogfabric": {
      "name": "Cognitive Fabric",
      "env": [
        "COGFABRIC_SERVER_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8234/v1"
      },
      "models": {
        "cogfabric-agent": {
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "variants": [
            {
              "id": "none",
              "settings": {
                "reasoningEffort": "none"
              }
            },
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            }
          ],
          "limit": {
            "context": 32768,
            "output": 1024
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    }
  ]
}
